# 서버 전용 환경변수 (클라이언트로 전달되지 않음). 실제 값은 .env 에 넣지 말고 배포 환경의 비밀 변수로 설정하세요.
# 1) AI 구술 평가 — 없으면 '데모 채점(규칙 기반)'으로 동작
ANTHROPIC_API_KEY=
# 사용할 모델 (기본값 claude-opus-5-5)
BODYQUEST_AI_MODEL=claude-opus-5-5

# 2) 복습 푸시 알림 — `npm run vapid` 로 키 생성
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:teacher@example.com

PORT=8787
